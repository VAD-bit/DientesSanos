# ── Centro Odontológico Dientes Sanos — variables de entorno ─────────────────
# Copia este archivo a .env.local en desarrollo. En Vercel: Settings → Environment Variables.

# ── Públicas del navegador (prefijo VITE_) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PASSKEYS_ENABLED=false

# ── Privadas: solo Vercel Functions / servidor. NUNCA usar prefijo VITE_ ────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PASSKEY_RP_NAME=Dientes Sanos
PASSKEY_RP_ID=odontosonrisa-crm.vercel.app
PASSKEY_ORIGIN=https://odontosonrisa-crm.vercel.app
PASSKEY_RATE_LIMIT_SECRET=
